      "html": "<header class=\"ds-top\"><a class=\"ds-brand\"><span class=\"ds-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 20V9l8-5 8 5v11\"/><path d=\"M9 20v-6h6v6\"/></svg></span><b>Patent Yard</b></a><nav><a aria-current=\"page\">Free to use</a><a>All patents</a><a>How it works</a></nav></header>",
      "css": ".ds-top{display:flex;align-items:center;gap:20px;min-height:52px;padding:0 20px;background:rgba(255,255,255,.8);backdrop-filter:saturate(1.8) blur(20px);border-bottom:1px solid rgba(227,227,232,.7);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text',Inter,sans-serif} .ds-brand{display:flex;align-items:center;gap:9px;color:#1D1D1F} .ds-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#1D1D1F;color:#fff} .ds-mark svg{width:18px;height:18px} .ds-brand b{font:600 17px/1 -apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif;letter-spacing:-0.02em} .ds-top nav{display:flex;gap:4px} .ds-top nav a{padding:8px 11px;font-size:13.5px;color:#424245;cursor:pointer;transition:color .2s} .ds-top nav a:hover{color:#1D1D1F} .ds-top nav a[aria-current=page]{color:#1D1D1F;font-weight:600}"
