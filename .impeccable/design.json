  "narrative": {
    "northStar": "The Drawing Is the Product Shot",
    "overview": "Patent Yard is a modern product site in the Apple manner. White pages alternate with full-bleed light gray bands, headlines are large and semibold, controls are pills, and containers are softly rounded tiles. Everything recedes so the real USPTO line drawings can be shown big, the way a product site shows its hardware. The home page plots one patent drawing live inside a large rounded frame, with a round magnifier that follows the pointer.\n\nDensity is generous on persuasive surfaces (home, how it works) and tighter on working surfaces (browse filters, patent pages, account), but it stays one world: the same tokens, radii and pill controls everywhere, including the archive and worldwide patent pages served by the edge functions. Dark mode follows the system and goes to true black with #1C1C1E tiles; drawings are inverted and screen-blended so they read as white line art.\n\nThe user rejected an earlier standards-manual direction for this one. The confirmed refusals: no neon on black, no glows, no gradient text, no eyebrow labels, no icon-card grids.",
    "keyCharacteristics": [
      "White and #F5F5F7 bands; one blue for links and filled buttons; color otherwise reserved for status.",
      "System SF type, semibold, tightly tracked at large sizes.",
      "Pills for every control, 18px tiles, a 28px frame for the hero drawing.",
      "Real patent drawings, multiply-blended on white, inverted in dark mode.",
      "Thin translucent sticky header; flat surfaces, soft shadows only on lift and overlays."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue is the only interactive color. Status hues never act as buttons, and blue never marks a status.",
        "section": "colors"
      },
      {
        "name": "The Green Means Free Rule",
        "body": "Green appears only where a patent is free to use or an action succeeded.",
        "section": "colors"
      },
      {
        "name": "The Semibold Headline Rule",
        "body": "Every heading is weight 600. Tracking runs from -0.011em at body size to -0.025em at display size and never tighter.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels are sentence case at zero tracking. No uppercase tracked labels.",
        "section": "typography"
      },
      {
        "name": "The Lift on Intent Rule",
        "body": "A surface gains a shadow only when it floats (overlays) or responds to the pointer (cards). Resting tiles are flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** show the real patent drawing large, on a white plate, multiply-blended (inverted and screen-blended in dark mode).",
      "**Do** alternate white sections with full-bleed band-gray bands at 96px section spacing.",
      "**Do** keep exactly one filled blue pill per action group; pair it with a link-style \"›\" action.",
      "**Do** set every heading at weight 600 with tracking between -0.011em and -0.025em.",
      "**Do** use tabular figures for counts, dates, claim numbers and stats.",
      "**Do** keep green for \"free to use\" and success only."
    ],
    "donts": [
      "**Don't** use gradients on surfaces, buttons or text. Gradients appear only as functional fade masks on scrolling rows and in the loading shimmer.",
      "**Don't** use glows, neon on black, or colored shadows.",
      "**Don't** put eyebrow or kicker labels above headlines, and don't use uppercase tracked labels.",
      "**Don't** track headlines tighter than -0.025em or set them heavier than 600.",
      "**Don't** build icon-card grids; tiles carry drawings or text, not decorative icons.",
      "**Don't** put two filled buttons side by side."
    ]
  }
