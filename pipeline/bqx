#!/bin/bash
# bq / gcloud with this Mac's working Python (the python3 shim is blocked until the Xcode license is accepted)
export CLOUDSDK_PYTHON=/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3
export CLOUDSDK_CORE_DISABLE_PROMPTS=1 PATH="$HOME/google-cloud-sdk/bin:$PATH"
"$@" 2> >(grep -v -i -E "python 3.9|reinstall|compatible python|CLOUDSDK_PYTHON|^\s*\\\$ gcloud|^$" >&2)
